{
  ".defaults": {
    "image": "registry.example/ci/build:19.2",
    "timeout_minutes": 30,
    "retry": 1,
    "env": {
      "GOFLAGS": "-mod=readonly",
      "CGO_ENABLED": "0",
      "REGION": "eu-north-1"
    }
  },
  ".cache": {
    "cache": {
      "key": "go-d3aea443",
      "paths": [
        ".cache/go-build",
        ".cache/gomod"
      ]
    },
    "retry": 2
  },
  ".arm": {
    "platform": "linux/arm64",
    "timeout_minutes": 45
  },
  "jobs": {
    "lint": {
      "image": "registry.example/ci/build:19.2",
      "timeout_minutes": 30,
      "retry": 1,
      "env": {
        "GOFLAGS": "-mod=readonly",
        "CGO_ENABLED": "0",
        "REGION": "eu-north-1"
      },
      "script": [
        "make lint"
      ]
    },
    "test": {
      "image": "registry.example/ci/build:19.2",
      "timeout_minutes": 20,
      "retry": 2,
      "env": {
        "GOFLAGS": "-mod=readonly",
        "CGO_ENABLED": "0",
        "REGION": "eu-north-1"
      },
      "cache": {
        "key": "go-d3aea443",
        "paths": [
          ".cache/go-build",
          ".cache/gomod"
        ]
      },
      "script": [
        "make test"
      ]
    },
    "build-arm": {
      "cache": {
        "key": "go-d3aea443",
        "paths": [
          ".cache/go-build",
          ".cache/gomod"
        ]
      },
      "retry": 1,
      "image": "registry.example/ci/build:19.2",
      "timeout_minutes": 45,
      "env": {
        "GOFLAGS": "-mod=readonly",
        "CGO_ENABLED": "1",
        "REGION": "eu-north-1",
        "GOARCH": "arm64"
      },
      "platform": "linux/arm64",
      "script": [
        "make build",
        "make package"
      ]
    },
    "release": {
      "image": "registry.example/ci/build:19.2",
      "timeout_minutes": 30,
      "retry": 1,
      "env": {
        "GOFLAGS": "-mod=readonly",
        "CGO_ENABLED": "0",
        "REGION": "eu-north-1"
      },
      "needs": [
        "lint",
        "test",
        "build-arm"
      ],
      "script": [
        "make build",
        "make package"
      ]
    }
  }
}
