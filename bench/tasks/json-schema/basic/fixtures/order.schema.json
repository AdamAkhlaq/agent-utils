{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order",
  "type": "object",
  "required": [
    "id",
    "email",
    "placed",
    "status",
    "currency",
    "total",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ORD-[0-9]{6}$"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "placed": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "pending",
        "paid",
        "shipped",
        "cancelled"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "total": {
      "type": "number",
      "exclusiveMinimum": 0,
      "multipleOf": 0.01
    },
    "notes": {
      "type": "string",
      "maxLength": 200
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sku",
          "qty"
        ],
        "additionalProperties": false,
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^[A-Z]{3}-[0-9]{4}$"
          },
          "qty": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
